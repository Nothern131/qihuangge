[
  # ===== 医经类（黄帝内经）10条 =====
  {"id":"hn_001","source":"黄帝内经","chapter":"素问·阴阳应象大论","original_text":"阴阳者，天地之道也，万物之纲纪，变化之父母，生杀之本始，神明之府也。","keywords":["阴阳","天地","纲纪"],"category":"医经","subject_area":"阴阳理论","bianzheng_type":null,"syndrome_keywords":[],"formula_keywords":[],"herb_keywords":[],"commentary":"阴阳是天地运行的根本规律，万物变化的总纲。","confidence":1.0},
  {"id":"hn_002","source":"黄帝内经","chapter":"素问·阴阳应象大论","original_text":"阳化气，阴成形。","keywords":["阳","阴","化气","成形"],"category":"医经","subject_area":"阴阳理论","bianzheng_type":null,"syndrome_keywords":[],"formula_keywords":[],"herb_keywords":[],"commentary":"阳主气化功能，阴主物质形质。","confidence":1.0},
  {"id":"hn_003","source":"黄帝内经","chapter":"素问·阴阳应象大论","original_text":"阴胜则阳病，阳胜则阴病。阳胜则热，阴胜则寒。","keywords":["阴胜","阳胜","热","寒"],"category":"医经","subject_area":"阴阳失调","bianzheng_type":null,"syndrome_keywords":["阳胜热证","阴胜寒证"],"formula_keywords":[],"herb_keywords":[],"commentary":"阴阳偏胜则导致对侧受损，阳胜则热，阴胜则寒。","confidence":1.0},
  {"id":"hn_004","source":"黄帝内经","chapter":"素问·生气通天论","original_text":"阳气者，若天与日，失其所则折寿而不彰。","keywords":["阳气","天日"],"category":"医经","subject_area":"阳气理论","bianzheng_type":null,"syndrome_keywords":["阳虚"],"formula_keywords":[],"herb_keywords":[],"commentary":"阳气如天之日光，至关重要。","confidence":1.0},
  {"id":"hn_005","source":"黄帝内经","chapter":"素问·灵兰秘典论","original_text":"心者，君主之官也，神明出焉。","keywords":["心","君主","神明"],"category":"医经","subject_area":"脏腑理论","bianzheng_type":null,"syndrome_keywords":[],"formula_keywords":[],"herb_keywords":[],"commentary":"心为五脏六腑之大主，主神明。","confidence":1.0},
  {"id":"hn_006","source":"黄帝内经","chapter":"素问·灵兰秘典论","original_text":"肺者，相傅之官，治节出焉。肝者，将军之官，谋虑出焉。","keywords":["肺","肝","相傅","将军"],"category":"医经","subject_area":"脏腑理论","bianzheng_type":null,"syndrome_keywords":[],"formula_keywords":[],"herb_keywords":[],"commentary":"肺主治节，肝主谋虑。","confidence":1.0},
  {"id":"hn_007","source":"黄帝内经","chapter":"素问·经脉别论","original_text":"食气入胃，散精于肝，淫气于筋。食气入胃，浊气归心，淫精于脉。","keywords":["胃","肝","筋","心","脉"],"category":"医经","subject_area":"气血津液","bianzheng_type":null,"syndrome_keywords":[],"formula_keywords":[],"herb_keywords":[],"commentary":"水谷精微的输布与脏腑相关。","confidence":1.0},
  {"id":"hn_008","source":"黄帝内经","chapter":"素问·举痛论","original_text":"百病生于气也：怒则气上，喜则气缓，悲则气消，恐则气下，寒则气收，炅则气泄，惊则气乱，劳则气耗，思则气结。","keywords":["气","怒","喜","悲","恐","寒","热","惊","劳","思"],"category":"医经","subject_area":"病机","bianzheng_type":null,"syndrome_keywords":["气机上逆","气虚下陷","气机紊乱"],"formula_keywords":[],"herb_keywords":[],"commentary":"七情内伤，气机失调，为百病之源。","confidence":1.0},
  {"id":"hn_009","source":"黄帝内经","chapter":"素问·至真要大论","original_text":"治病必求于本。","keywords":["治病","求本"],"category":"医经","subject_area":"治疗原则","bianzheng_type":null,"syndrome_keywords":[],"formula_keywords":[],"herb_keywords":[],"commentary":"治病须求其根本，审证求因。","confidence":1.0},
  {"id":"hn_010","source":"黄帝内经","chapter":"素问·上古天真论","original_text："恬淡虚无，真气从之，精神内守，病安从来。","keywords":["恬淡虚无","真气"],"category":"医经","subject_area":"养生","bianzheng_type":null,"syndrome_keywords":[],"formula_keywords":[],"herb_keywords":[],"commentary":"养生之要，在于恬淡虚无，精神内守。","confidence":1.0},

  # ===== 伤寒论 15条 =====
  {"id":"sh_001","source":"伤寒论","chapter":"辨太阳病脉证并治上","original_text":"太阳之为病，脉浮，头项强痛而恶寒。","keywords":["太阳","脉浮","头项强痛","恶寒"],"category":"伤寒","subject_area":"六经辨证","bianzheng_type":"太阳病","syndrome_keywords":["太阳经证","表证"],"formula_keywords":["麻黄汤","桂枝汤"],"herb_keywords":[],"commentary":"太阳病提纲证。太阳主表，外邪侵袭，卫阳抗邪，故脉浮、头项强痛、恶寒并见。","confidence":1.0},
  {"id":"sh_002","source":"伤寒论","chapter":"辨太阳病脉证并治上","original_text":"太阳病，发热，汗出，恶风，脉缓者，名为中风。","keywords":["太阳","发热","汗出","恶风","中风"],"category":"伤寒","subject_area":"六经辨证","bianzheng_type":"太阳中风","syndrome_keywords":["太阳表虚证"],"formula_keywords":["桂枝汤"],"herb_keywords":[],"commentary":"太阳中风证，营卫不和，卫强营弱。","confidence":1.0},
  {"id":"sh_003","source":"伤寒论","chapter":"辨太阳病脉证并治上","original_text":"太阳病，头痛，发热，汗出，恶风，桂枝汤主之。","keywords":["太阳","头痛","发热","桂枝汤"],"category":"伤寒","subject_area":"方证对应","bianzheng_type":"太阳中风","syndrome_keywords":["太阳表虚证"],"formula_keywords":["桂枝汤"],"herb_keywords":["桂枝","白芍","生姜","大枣","甘草"],"commentary":"桂枝汤为群方之祖，主治太阳中风表虚证。","confidence":1.0},
  {"id":"sh_004","source":"伤寒论","chapter":"辨太阳病脉证并治中","original_text":"太阳病，项背强几几，无汗恶风，葛根汤主之。","keywords":["太阳","项背强","无汗","葛根汤"],"category":"伤寒","subject_area":"方证对应","bianzheng_type":"太阳伤寒兼经输不利","syndrome_keywords":["太阳伤寒证"],"formula_keywords":["葛根汤"],"herb_keywords":["葛根","麻黄","桂枝","白芍","生姜","大枣","甘草"],"commentary":"太阳伤寒，经气不利，项背强几几，葛根汤主之。","confidence":1.0},
  {"id":"sh_005","source":"伤寒论","chapter":"辨太阳病脉证并治中","original_text":"太阳病，发热汗出，恶风脉缓者，此为营弱卫强，故使汗出。欲救邪风者，宜桂枝汤。","keywords":["营弱卫强","桂枝汤"],"category":"伤寒","subject_area":"方证对应","bianzheng_type":"太阳中风","syndrome_keywords":["太阳表虚证"],"formula_keywords":["桂枝汤"],"herb_keywords":[],"commentary":"营弱卫强，汗出恶风，桂枝汤主之。","confidence":1.0},
  {"id":"sh_006","source":"伤寒论","chapter":"辨太阳病脉证并治中","original_text":"太阳病，脉浮紧，无汗，发热，身疼痛，八九日不解，表证仍在，此当发其汗。麻黄汤主之。","keywords":["太阳","脉浮紧","无汗","麻黄汤"],"category":"伤寒","subject_area":"方证对应","bianzheng_type":"太阳伤寒","syndrome_keywords":["太阳表实证"],"formula_keywords":["麻黄汤"],"herb_keywords":["麻黄","桂枝","杏仁","甘草"],"commentary":"太阳伤寒表实证，麻黄汤主之。","confidence":1.0},
  {"id":"sh_007","source":"伤寒论","chapter":"辨少阳病脉证并治","original_text":"少阳之为病，口苦，咽干，目眩也。","keywords":["少阳","口苦","咽干","目眩"],"category":"伤寒","subject_area":"六经辨证","bianzheng_type":"少阳病","syndrome_keywords":["少阳证"],"formula_keywords":["小柴胡汤"],"herb_keywords":[],"commentary":"少阳病提纲证。少阳胆火上炎，故口苦咽干目眩。","confidence":1.0},
  {"id":"sh_008","source":"伤寒论","chapter":"辨少阳病脉证并治","original_text":"伤寒五六日中风，往来寒热，胸胁苦满，默默不欲饮食，心烦喜呕，或胸中烦而不呕，或渴，或腹中痛，或胁下痞硬，或心下悸，小便不利，或不渴，身有微热，或咳者，小柴胡汤主之。","keywords":["少阳","往来寒热","胸胁苦满","小柴胡汤"],"category":"伤寒","subject_area":"方证对应","bianzheng_type":"少阳病","syndrome_keywords":["少阳证"],"formula_keywords":["小柴胡汤"],"herb_keywords":["柴胡","黄芩","半夏","人参","生姜","大枣","甘草"],"commentary":"少阳病主方，但见一证便是，不必悉具。","confidence":1.0},
  {"id":"sh_009","source":"伤寒论","chapter":"辨阳明病脉证并治","original_text":"阳明之为病，胃家实是也。","keywords":["阳明","胃家实"],"category":"伤寒","subject_area":"六经辨证","bianzheng_type":"阳明病","syndrome_keywords":["阳明腑实证","阳明经证"],"formula_keywords":["承气汤","白虎汤"],"herb_keywords":[],"commentary":"阳明病提纲，胃家实乃阳明病本质。","confidence":1.0},
  {"id":"sh_010","source":"伤寒论","chapter":"辨阳明病脉证并治","original_text":"阳明病，脉浮而紧者，必潮热，发作有时。但浮者，必盗汗出。","keywords":["阳明","脉浮紧","潮热"],"category":"伤寒","subject_area":"六经辨证","bianzheng_type":"阳明病","syndrome_keywords":["阳明经证"],"formula_keywords":["白虎汤"],"herb_keywords":[],"commentary":"阳明经证，潮热盗汗，白虎汤主之。","confidence":1.0},
  {"id":"sh_011","source":"伤寒论","chapter":"辨阳明病脉证并治","original_text":"阳明病，发热汗出者，此为热越，不能发黄也。但头汗出，身无汗，剂颈而还，小便不利，渴引水浆者，此为瘀热在里，身必发黄，茵陈蒿汤主之。","keywords":["阳明","发黄","茵陈蒿汤"],"category":"伤寒","subject_area":"方证对应","bianzheng_type":"阳明发黄","syndrome_keywords":["湿热发黄"],"formula_keywords":["茵陈蒿汤"],"herb_keywords":["茵陈","栀子","大黄"],"commentary":"阳明湿热发黄，茵陈蒿汤主之。","confidence":1.0},
  {"id":"sh_012","source":"伤寒论","chapter":"辨太阴病脉证并治","original_text":"太阴之为病，腹满而吐，食不下，自利益甚，时腹自痛。若下之，必胸下结硬。","keywords":["太阴","腹满","吐","下利"],"category":"伤寒","subject_area":"六经辨证","bianzheng_type":"太阴病","syndrome_keywords":["太阴脾虚寒湿"],"formula_keywords":["理中汤"],"herb_keywords":[],"commentary":"太阴病提纲，脾虚寒湿，腹满自利。","confidence":1.0},
  {"id":"sh_013","source":"伤寒论","chapter":"辨少阴病脉证并治","original_text":"少阴之为病，脉微细，但欲寐也。","keywords":["少阴","脉微细","但欲寐"],"category":"伤寒","subject_area":"六经辨证","bianzheng_type":"少阴病","syndrome_keywords":["少阴心肾虚衰"],"formula_keywords":["四逆汤","黄连阿胶汤"],"herb_keywords":[],"commentary":"少阴病提纲，心肾阳虚，脉微细但欲寐。","confidence":1.0},
  {"id":"sh_014","source":"伤寒论","chapter":"辨厥阴病脉证并治","original_text":"厥阴之为病，消渴，气上撞心，心中疼热，饥而不欲食，食则吐蛔，下之利不止。","keywords":["厥阴","消渴","气上撞心"],"category":"伤寒","subject_area":"六经辨证","bianzheng_type":"厥阴病","syndrome_keywords":["厥阴寒热错杂"],"formula_keywords":["乌梅丸"],"herb_keywords":[],"commentary":"厥阴病提纲，寒热错杂，消渴气上撞心。","confidence":1.0},
  {"id":"sh_015","source":"伤寒论","chapter":"辨太阳病脉证并治下","original_text":"观其脉证，知犯何逆，随证治之。","keywords":["观其脉证","随证治之"],"category":"伤寒","subject_area":"治疗原则","bianzheng_type":null,"syndrome_keywords":[],"formula_keywords":[],"herb_keywords":[],"commentary":"张仲景治则核心：辨证论治，随证施治。","confidence":1.0},

  # ===== 本草类（神农本草经 + 本草纲目）10条 =====
  {"id":"bc_001","source":"神农本草经","chapter":"上品·人参","original_text":"人参，主补五脏，安精神，定魂魄，止惊悸，除邪气，明目，开心益智。久服，轻身延年。","keywords":["人参","补五脏","安精神"],"category":"本草","subject_area":"补气药","bianzheng_type":null,"syndrome_keywords":["气虚"],"formula_keywords":["四君子汤","补中益气汤"],"herb_keywords":["人参"],"commentary":"人参为补气要药，大补元气，复脉固脱。","confidence":1.0},
  {"id":"bc_002","source":"神农本草经","chapter":"上品·黄芪","original_text":"黄芪，主痈疽久败疮，排脓止痛，大风癞疾，五痔鼠瘘，补虚，小儿百病。","keywords":["黄芪","排脓","补虚"],"category":"本草","subject_area":"补气药","bianzheng_type":null,"syndrome_keywords":["气虚"],"formula_keywords":["补中益气汤","当归补血汤"],"herb_keywords":["黄芪"],"commentary":"黄芪补气升阳，固表止汗，利水消肿。","confidence":1.0},
  {"id":"bc_003","source":"神农本草经","chapter":"上品·当归","original_text":"当归，主咳逆上气，温疟寒热，在腹中，淋漓痢疾，女子漏下绝子，诸恶疮疡金疮。","keywords":["当归","温疟","漏下"],"category":"本草","subject_area":"补血药","bianzheng_type":null,"syndrome_keywords":["血虚"],"formula_keywords":["四物汤","当归补血汤"],"herb_keywords":["当归"],"commentary":"当归补血活血，调经止痛，润肠通便。","confidence":1.0},
  {"id":"bc_004","source":"神农本草经","chapter":"中品·芍药","original_text":"芍药，主邪气腹痛，除血痹，破坚积，寒热疝瘕，止痛，利小便，益气。","keywords":["芍药","止痛","血痹"],"category":"本草","subject_area":"补血药","bianzheng_type":null,"syndrome_keywords":["血虚","肝郁"],"formula_keywords":["四物汤","芍药甘草汤"],"herb_keywords":["芍药"],"commentary":"芍药养血柔肝，缓急止痛。","confidence":1.0},
  {"id":"bc_005","source":"神农本草经","chapter":"上品·甘草","original_text":"甘草，主五脏六腑寒热邪气，坚筋骨，长肌肉，倍力，金疮肿，解毒。","keywords":["甘草","解毒","调和"],"category":"本草","subject_area":"补气药","bianzheng_type":null,"syndrome_keywords":["气虚"],"formula_keywords":["四君子汤","芍药甘草汤"],"herb_keywords":["甘草"],"commentary":"甘草补脾益气，清热解毒，祛痰止咳，缓急止痛，调和诸药。","confidence":1.0},
  {"id":"bc_006","source":"本草纲目","chapter":"草部·麻黄","original_text":"麻黄，发表出汗，去邪热气，止咳逆上气，除寒热，破症坚积聚。","keywords":["麻黄","发表","止咳"],"category":"本草","subject_area":"解表药","bianzheng_type":null,"syndrome_keywords":["表实证"],"formula_keywords":["麻黄汤","麻黄杏仁甘草石膏汤"],"herb_keywords":["麻黄"],"commentary":"麻黄发汗解表，宣肺平喘，利水消肿。","confidence":1.0},
  {"id":"bc_007","source":"本草纲目","chapter":"草部·桂枝","original_text":"桂枝，能治肢体疼痛，头目风眩，肠风泄利，皮肤瘙痒，散阴滞，开郁结。","keywords":["桂枝","散寒","通阳"],"category":"本草","subject_area":"解表药","bianzheng_type":null,"syndrome_keywords":["表虚证","寒证"],"formula_keywords":["桂枝汤","苓桂术甘汤"],"herb_keywords":["桂枝"],"commentary":"桂枝发汗解肌，温通经脉，助阳化气。","confidence":1.0},
  {"id":"bc_008","source":"神农本草经","chapter":"上品·大枣","original_text":"大枣，主心腹邪气，安中，养脾气，平胃气，通九窍，助十二经，补少气少津液，身中不足，大惊，四肢重，和百药。","keywords":["大枣","安中","养脾"],"category":"本草","subject_area":"补气药","bianzheng_type":null,"syndrome_keywords":["气虚"],"formula_keywords":["桂枝汤","小柴胡汤"],"herb_keywords":["大枣"],"commentary":"大枣补中益气，养血安神。","confidence":1.0},
  {"id":"bc_009","source":"神农本草经","chapter":"上品·生姜","original_text":"生姜，主伤寒头痛鼻塞，咳逆上气，止呕吐。","keywords":["生姜","止呕","散寒"],"category":"本草","subject_area":"解表药","bianzheng_type":null,"syndrome_keywords":["表证","寒证"],"formula_keywords":["桂枝汤","小柴胡汤"],"herb_keywords":["生姜"],"commentary":"生姜发散风寒，温中止呕，温肺止咳。","confidence":1.0},
  {"id":"bc_010","source":"本草纲目","chapter":"草部·柴胡","original_text":"柴胡，主心腹肠胃中结气，饮食积聚，寒热邪气，推陈致新，久服轻身明目益精。","keywords":["柴胡","疏肝","解郁"],"category":"本草","subject_area":"解表药","bianzheng_type":null,"syndrome_keywords":["少阳证","肝郁"],"formula_keywords":["小柴胡汤","逍遥散"],"herb_keywords":["柴胡"],"commentary":"柴胡疏肝解郁，升举阳气，和解表里。","confidence":1.0},

  # ===== 方剂类 10条 =====
  {"id":"fj_001","source":"伤寒论","chapter":"辨太阳病脉证并治","original_text":"桂枝汤方：桂枝三两（去皮），芍药三两，甘草二两（炙），生姜三两（切），大枣十二枚（擘）。","keywords":["桂枝汤","君臣佐使","解表"],"category":"方剂","subject_area":"解表剂","bianzheng_type":"太阳中风","syndrome_keywords":["太阳表虚证"],"formula_keywords":["桂枝汤"],"herb_keywords":["桂枝","白芍","生姜","大枣","甘草"],"commentary":"桂枝汤为群方之祖，解肌发表，调和营卫。君桂枝，臣芍药，佐姜枣，使甘草。","confidence":1.0},
  {"id":"fj_002","source":"伤寒论","chapter":"辨太阳病脉证并治","original_text":"麻黄汤方：麻黄三两（去节），桂枝二两（去皮），杏仁七十个（去皮尖），甘草一两（炙）。","keywords":["麻黄汤","发汗","解表"],"category":"方剂","subject_area":"解表剂","bianzheng_type":"太阳伤寒","syndrome_keywords":["太阳表实证"],"formula_keywords":["麻黄汤"],"herb_keywords":["麻黄","桂枝","杏仁","甘草"],"commentary":"麻黄汤发汗解表，宣肺平喘。君麻黄，臣桂枝，佐杏仁，使甘草。","confidence":1.0},
  {"id":"fj_003","source":"伤寒论","chapter":"辨少阳病脉证并治","original_text":"小柴胡汤方：柴胡半斤，黄芩三两，人参三两，半夏半升（洗），甘草三两（炙），生姜三两（切），大枣十二枚（擘）。","keywords":["小柴胡汤","和解","少阳"],"category":"方剂","subject_area":"和解剂","bianzheng_type":"少阳病","syndrome_keywords":["少阳证"],"formula_keywords":["小柴胡汤"],"herb_keywords":["柴胡","黄芩","半夏","人参","生姜","大枣","甘草"],"commentary":"小柴胡汤和解少阳。君柴胡，臣黄芩，佐半夏人参，使草枣姜。","confidence":1.0},
  {"id":"fj_004","source":"太平惠民和剂局方","chapter":"卷之五","original_text":"四君子汤：人参、白术、茯苓各等分，甘草焙干半两。","keywords":["四君子汤","补气","健脾"],"category":"方剂","subject_area":"补益剂","bianzheng_type":null,"syndrome_keywords":["脾胃气虚"],"formula_keywords":["四君子汤"],"herb_keywords":["人参","白术","茯苓","甘草"],"commentary":"四君子汤益气健脾，为补气基础方。君人参，臣白术，佐茯苓，使甘草。","confidence":1.0},
  {"id":"fj_005","source":"小儿药证直诀","chapter":"卷下","original_text":"六味地黄丸：熟地黄八两，山茱萸四两，干山药四两，泽泻三两，牡丹皮三两，茯苓三两。","keywords":["六味地黄丸","滋阴","补肾"],"category":"方剂","subject_area":"补益剂","bianzheng_type":null,"syndrome_keywords":["肝肾阴虚"],"formula_keywords":["六味地黄丸"],"herb_keywords":["熟地黄","山茱萸","山药","泽泻","牡丹皮","茯苓"],"commentary":"六味地黄丸滋补肝肾，三补三泻。君熟地，臣山茱萸山药，佐泽泻丹皮茯苓。","confidence":1.0},
  {"id":"fj_006","source":"太平惠民和剂局方","chapter":"卷之五","original_text":"逍遥散：当归、白芍、白术、茯苓各一两，柴胡一两半，甘草半两。","keywords":["逍遥散","疏肝","健脾"],"category":"方剂","subject_area":"和解剂","bianzheng_type":null,"syndrome_keywords":["肝郁脾虚"],"formula_keywords":["逍遥散"],"herb_keywords":["柴胡","当归","白芍","白术","茯苓","薄荷","生姜","甘草"],"commentary":"逍遥散疏肝解郁，养血健脾。君柴胡，臣归芍，佐术苓，使草姜薄。","confidence":1.0},
  {"id":"fj_007","source":"脾胃论","chapter":"卷上","original_text":"补中益气汤：黄芪一钱，人参去芦，甘草炙各五分，当归酒洗，陈皮去白，升麻，柴胡各三分。","keywords":["补中益气汤","补气","升阳"],"category":"方剂","subject_area":"补益剂","bianzheng_type":null,"syndrome_keywords":["中气下陷"],"formula_keywords":["补中益气汤"],"herb_keywords":["黄芪","人参","白术","当归","陈皮","升麻","柴胡","甘草"],"commentary":"补中益气汤补中益气，升阳举陷。李东垣方。","confidence":1.0},
  {"id":"fj_008","source":"伤寒论","chapter":"辨太阳病脉证并治","original_text":"葛根汤方：葛根四两，麻黄三两（去节），桂枝二两（去皮），生姜三两（切），甘草二两（炙），芍药二两，大枣十二枚（擘）。","keywords":["葛根汤","解表","项背强"],"category":"方剂","subject_area":"解表剂","bianzheng_type":"太阳伤寒兼经输不利","syndrome_keywords":["太阳伤寒证"],"formula_keywords":["葛根汤"],"herb_keywords":["葛根","麻黄","桂枝","白芍","生姜","大枣","甘草"],"commentary":"葛根汤解肌发表，升津舒筋。主治太阳伤寒项背强几几。","confidence":1.0},
  {"id":"fj_009","source":"温病条辨","chapter":"卷一","original_text":"银翘散：连翘一两，银花一两，苦桔梗六钱，薄荷六钱，竹叶四钱，生甘草五钱，荆芥穗四钱，淡豆豉五钱，牛蒡子六钱。","keywords":["银翘散","辛凉","解表"],"category":"方剂","subject_area":"解表剂","bianzheng_type":null,"syndrome_keywords":["风热表证"],"formula_keywords":["银翘散"],"herb_keywords":["连翘","金银花","桔梗","薄荷","竹叶","甘草","荆芥","豆豉","牛蒡子"],"commentary":"银翘散辛凉透表，清热解毒。吴鞠通方。","confidence":1.0},
  {"id":"fj_010","source":"温病条辨","chapter":"卷一","original_text":"桑菊饮：杏仁二钱，连翘一钱五分，薄荷八分，桑叶八钱，菊花一钱，苦梗二钱，甘草八分，芦根二钱。","keywords":["桑菊饮","疏风","清热"],"category":"方剂","subject_area":"解表剂","bianzheng_type":null,"syndrome_keywords":["风热咳嗽"],"formula_keywords":["桑菊饮"],"herb_keywords":["桑叶","菊花","杏仁","连翘","薄荷","桔梗","甘草","芦根"],"commentary":"桑菊饮疏风清热，宣肺止咳。吴鞠通方。","confidence":1.0}
]
